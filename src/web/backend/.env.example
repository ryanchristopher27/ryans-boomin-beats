SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/profile
LASTFM_API_KEY=your-lastfm-api-key

# --- hosted instance only (leave unset for local dev) ---
# Shared secret the iOS client must send as X-Device-Key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_KEY=
# Comma-separated browser origins. Defaults to http://127.0.0.1:5173.
# The hosted instance serves a native client and normally needs none.
ALLOWED_ORIGINS=
